rules_version = '2';

// Reglas de Cloud Firestore para Cucú.
// Todos entran con sesión anónima (sin cuentas). Las reglas cuidan que:
//  - solo el anfitrión cambie el bloqueo del reloj y los moderadores,
//  - con el reloj bloqueado, solo anfitrión y moderadores lo manejen,
//  - cada persona escriba solo sus propias estadísticas y mensajes.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function roomOk(d) {
      return d.name is string && d.name.size() <= 40
        && d.goal is string && d.goal.size() <= 80
        && d.music is string && d.music.size() <= 300
        && d.mods is list && d.mods.size() <= 20
        && d.log is list && d.log.size() <= 30
        && d.focusMin is number && d.breakMin is number && d.longMin is number;
    }

    match /rooms/{code} {
      function isHost() {
        return resource.data.get('hostId', null) == null
          || resource.data.get('hostId', null) == request.auth.uid;
      }
      function isMod() {
        return request.auth.uid in resource.data.get('mods', []);
      }
      function adminFieldsUnchanged() {
        return request.resource.data.get('lock', false) == resource.data.get('lock', false)
          && request.resource.data.get('mods', []) == resource.data.get('mods', []);
      }

      allow read: if signedIn();

      allow create: if signedIn()
        && code.matches('^[a-z0-9]{3,8}$')
        && roomOk(request.resource.data)
        && (request.resource.data.get('hostId', null) == null
            || request.resource.data.get('hostId', null) == request.auth.uid);

      allow update: if signedIn()
        && roomOk(request.resource.data)
        && request.resource.data.get('hostId', null) == resource.data.get('hostId', null)
        && (isHost()
            || (adminFieldsUnchanged()
                && (resource.data.get('lock', false) != true || isMod())));

      allow delete: if signedIn() && isHost();

      match /chat/{msgId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 400
          && request.resource.data.ts is number;
        allow delete: if signedIn();
      }

      match /stats/{uid} {
        allow read: if signedIn();
        allow write: if signedIn() && request.auth.uid == uid;
      }
    }
  }
}
