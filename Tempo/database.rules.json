{
  "rules": {
    "salas": {
      "$sala": {
        ".read": true,
        "estado": { ".write": true },
        "gente": {
          "$cliente": { ".write": true }
        }
      }
    },
    "tickets": {
      ".read": true,
      "$ticket": {
        ".write": "!data.exists()",
        ".validate": "newData.hasChildren(['tipo', 'titulo', 'estado', 'createdAt'])",
        "tipo": { ".validate": "newData.isString() && newData.val().matches(/^(mejora|bug|otro)$/)" },
        "titulo": { ".validate": "newData.isString() && newData.val().length >= 4 && newData.val().length <= 120" },
        "descripcion": { ".validate": "newData.isString() && newData.val().length <= 2000" },
        "autor": { ".validate": "newData.isString() && newData.val().length <= 24" },
        "contexto": { ".validate": "newData.isString() && newData.val().length <= 400" },
        "estado": { ".validate": "data.exists() || newData.val() === 'nuevo'" },
        "createdAt": { ".validate": "data.exists() || newData.val() === now" },
        "votos": {
          "$votante": {
            ".write": true,
            ".validate": "newData.val() === true && $votante.length <= 20"
          }
        },
        "$otro": { ".validate": false }
      }
    }
  }
}
